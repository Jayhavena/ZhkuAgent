package com.zhku.knowledge.serviceguide;

import com.zhku.knowledge.ZhkuFlywayTestSupport;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.zhku.knowledge.ZhkuDatabaseTestConfig;
import com.zhku.knowledge.conversation.elective.ElectiveRetakeReplyType;
import com.zhku.knowledge.routing.AnswerRoute;
import com.zhku.knowledge.web.LocalPreviewConversationFacade;
import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.jdbc.datasource.DriverManagerDataSource;

import javax.sql.DataSource;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.SQLException;
import java.sql.Timestamp;
import java.time.Clock;
import java.time.Instant;
import java.time.ZoneOffset;
import java.util.List;
import java.util.UUID;

import static org.assertj.core.api.Assertions.assertThat;

/**
 * 阶段 9 人工验收：一条"选课调整"链路，从回答卡到官方人工渠道。
 *
 * <p>验收对象是**回答卡上的清单视图**本身（它就是下发给学生的那份 payload），
 * 因此这里直接消费真实库里的已审核清单，而不是构造内存夹具：
 * ① 正常路径给出"下一步 + 需确认事项 + 官方渠道"；
 * ② 转人工路径只留渠道与需确认事项、`nextSteps` 恒空；
 * ③ 清单过期/不存在时不发明联系方式，只给方向性说明；
 * ④ 载荷字段名与 §八 登记一致（WB-1 据此做 UI）。</p>
 */
class ServiceGuideAcceptanceTest {

    private static final String DATABASE_URL = System.getProperty(
            "zhku.db.url", "jdbc:postgresql://127.0.0.1:54329/zhkuagent");
    private static final String DATABASE_USER = System.getProperty(
            "zhku.db.user", "zhkuagent");
    private static final String DATABASE_PASSWORD = ZhkuDatabaseTestConfig.databasePassword();

    private static final Instant NOW = Instant.parse("2026-09-21T00:00:00Z");
    private static final Clock CLOCK = Clock.fixed(NOW, ZoneOffset.UTC);

    /**
     * **夹具隔离约定（务必保持）**：本用例写入/删除的是**专用测试标识与版本**，
     * 绝不与演示数据（`elective-adjust / 2025版`）共用标识。
     *
     * <p>曾因共用标识出过事故：`@AfterEach` 按标识删行 → 每跑一次全量回归就把演示清单删掉，
     * 真机验收随即表现为 `guideCard=null`。共享演示库是所有会话共同使用的资产，
     * 测试只能动自己命名的数据。</p>
     */
    private static final String BINDING_KEY = "acceptance-test-binding";
    private static final String IDENTIFIER = "acceptance-test-guide";
    private static final String VERSION = "测试版";

    private DataSource dataSource;
    private ServiceGuideCardProvider provider;

    @BeforeEach
    void setUp() {
        ZhkuFlywayTestSupport.migrate(DATABASE_URL, DATABASE_USER, DATABASE_PASSWORD);
        dataSource = new DriverManagerDataSource(DATABASE_URL, DATABASE_USER, DATABASE_PASSWORD);
        // 用**测试自己的绑定**把卡片提供者指向测试清单，与生产绑定表（firstBatch）完全解耦。
        provider = new ServiceGuideCardProvider(
                new ServiceGuideBindings(List.of(new ServiceGuideBindings.Binding(
                        BINDING_KEY, IDENTIFIER, VERSION))),
                new ServiceGuideResolver(new JdbcServiceGuideRepository(dataSource), CLOCK));
        deleteFixtures();
    }

    @AfterEach
    void tearDown() {
        deleteFixtures();
    }

    @Test
    void shouldCarryStepsConfirmationsAndReviewedChannelsOnAnswerCard() {
        seedGuide(null);

        ServiceGuideCard card = provider.fullCard(BINDING_KEY).orElseThrow();

        assertThat(card.handoffOnly()).isFalse();
        assertThat(card.title()).isEqualTo("选课调整办理指引");
        assertThat(card.nextSteps()).extracting(ServiceGuideCard.NextStep::instruction)
                .containsExactly("查看当学期选课通知", "按通知到指定办公室确认");
        // 第二步要求个案核对：前端必须同时提示转人工，不能让学生以为照做即可办结。
        assertThat(card.nextSteps().get(1).requiresIdentityCheck()).isTrue();
        assertThat(card.confirmations()).containsExactly("以当学期官方通知为准");
        assertThat(card.officialChannels()).extracting(ServiceGuideCard.Channel::name)
                .containsExactly("教务处学籍科", "选课咨询专线");
        assertThat(card.officialChannels()).extracting(ServiceGuideCard.Channel::value)
                .containsExactly("教务处 201 室", "0755-12345678");
    }

    @Test
    void shouldKeepOnlyChannelsAndConfirmationsWhenHandoffIsRequired() {
        seedGuide(null);

        ServiceGuideCard card = provider.handoffCard(
                BINDING_KEY, HumanHandoffReason.INDIVIDUAL_ASSESSMENT).orElseThrow();

        // 个案认定：只留人工渠道 + 需确认事项，绝不给"下一步"。
        assertThat(card.handoffOnly()).isTrue();
        assertThat(card.nextSteps()).isEmpty();
        assertThat(card.officialChannels()).extracting(ServiceGuideCard.Channel::value)
                .containsExactly("教务处 201 室");
        assertThat(card.confirmations()).containsExactly("以当学期官方通知为准");
    }

    @Test
    void shouldNotInventChannelsWhenGuideHasExpired() {
        seedGuide(NOW.minusSeconds(3600));

        assertThat(provider.fullCard(BINDING_KEY)).isEmpty();
        ServiceGuideCard card = provider.handoffCard(
                BINDING_KEY, HumanHandoffReason.RULE_MISSING).orElseThrow();
        assertThat(card.nextSteps()).isEmpty();
        assertThat(card.officialChannels()).isEmpty();
    }

    @Test
    void shouldNotAttachAnyCardForUnboundDecisionPoint() {
        seedGuide(null);

        assertThat(provider.fullCard("not-bound")).isEmpty();
        assertThat(provider.handoffCard("not-bound", HumanHandoffReason.RULE_MISSING)).isEmpty();
    }

    @Test
    void shouldSerializeGuideCardFieldsAsRegisteredInSectionEight() throws Exception {
        seedGuide(null);
        ServiceGuideCard card = provider.fullCard(BINDING_KEY).orElseThrow();

        var reply = new LocalPreviewConversationFacade.ConversationReply(
                ElectiveRetakeReplyType.ANSWER, "按清单办理。", null,
                AnswerRoute.HIGH_RISK_RULE, false, List.of(), List.of(), card);
        String json = new ObjectMapper().writeValueAsString(reply);

        // 字段名与 §八 第 9 条一致；WB-1 直接按此渲染，不需要额外适配。
        assertThat(json).contains("\"guideCard\"");
        assertThat(json).contains("\"nextSteps\"");
        assertThat(json).contains("\"confirmations\"");
        assertThat(json).contains("\"officialChannels\"");
        assertThat(json).contains("教务处 201 室");
        assertThat(json).contains("0755-12345678");
    }

    private void seedGuide(Instant validUntil) {
        Instant publishedAt = NOW.minusSeconds(86400);
        try (Connection connection = dataSource.getConnection()) {
            execute(connection, """
                    INSERT INTO service_guide (id, guide_identifier, guide_version, title,
                        applicable_scope, source_rule_reference, review_notice,
                        student_visible, published_at, valid_until)
                    VALUES (?, ?, ?, '选课调整办理指引', '全日制本科生',
                        'PUBLIC_ELECTIVE_RULE#2025版', '审核说明', TRUE, ?, ?)
                    """, statement -> {
                statement.setObject(1, UUID.randomUUID());
                statement.setString(2, IDENTIFIER);
                statement.setString(3, VERSION);
                statement.setTimestamp(4, Timestamp.from(publishedAt));
                statement.setTimestamp(5, validUntil == null ? null : Timestamp.from(validUntil));
            });
            UUID guideId = guideId(connection);
            execute(connection, """
                    INSERT INTO service_guide_step (id, guide_id, step_order, instruction,
                        requires_identity_check)
                    VALUES (?, ?, 1, '查看当学期选课通知', FALSE), (?, ?, 2, '按通知到指定办公室确认', TRUE)
                    """, statement -> {
                statement.setObject(1, UUID.randomUUID());
                statement.setObject(2, guideId);
                statement.setObject(3, UUID.randomUUID());
                statement.setObject(4, guideId);
            });
            execute(connection, """
                    INSERT INTO service_guide_channel (id, guide_id, channel_order, channel_type,
                        channel_name, channel_value, source_locator, verified_at)
                    VALUES (?, ?, 1, 'SCHOOL_OFFICE', '教务处学籍科', '教务处 201 室', 'PDF 第 77 页', ?),
                           (?, ?, 2, 'PHONE', '选课咨询专线', '0755-12345678', 'PDF 第 77 页', ?)
                    """, statement -> {
                statement.setObject(1, UUID.randomUUID());
                statement.setObject(2, guideId);
                statement.setTimestamp(3, Timestamp.from(NOW));
                statement.setObject(4, UUID.randomUUID());
                statement.setObject(5, guideId);
                statement.setTimestamp(6, Timestamp.from(NOW));
            });
            execute(connection, """
                    INSERT INTO service_guide_risk_notice (id, guide_id, notice_order, notice_text)
                    VALUES (?, ?, 1, '以当学期官方通知为准')
                    """, statement -> {
                statement.setObject(1, UUID.randomUUID());
                statement.setObject(2, guideId);
            });
        } catch (SQLException exception) {
            throw new IllegalStateException("验收夹具写入失败", exception);
        }
    }

    private UUID guideId(Connection connection) throws SQLException {
        try (PreparedStatement statement = connection.prepareStatement(
                "SELECT id FROM service_guide WHERE guide_identifier = ? AND guide_version = ?")) {
            statement.setString(1, IDENTIFIER);
            statement.setString(2, VERSION);
            try (var result = statement.executeQuery()) {
                assertThat(result.next()).isTrue();
                return result.getObject("id", UUID.class);
            }
        }
    }

    private interface StatementBinder {
        void bind(PreparedStatement statement) throws SQLException;
    }

    private void execute(Connection connection, String sql, StatementBinder binder)
            throws SQLException {
        try (PreparedStatement statement = connection.prepareStatement(sql)) {
            binder.bind(statement);
            statement.executeUpdate();
        }
    }

    private void deleteFixtures() {
        try (Connection connection = dataSource.getConnection()) {
            for (String table : List.of("service_guide_step", "service_guide_material",
                    "service_guide_channel", "service_guide_risk_notice")) {
                execute(connection, "DELETE FROM " + table + " WHERE guide_id IN ("
                                + "SELECT id FROM service_guide WHERE guide_identifier = ?)",
                        statement -> statement.setString(1, IDENTIFIER));
            }
            execute(connection, "DELETE FROM service_guide WHERE guide_identifier = ?",
                    statement -> statement.setString(1, IDENTIFIER));
        } catch (SQLException exception) {
            throw new IllegalStateException("验收夹具清理失败", exception);
        }
    }
}
