+  app.provide('rule-check-runtime',{session:{state:{actor,epoch:0,identityBusy:false,reason}},client:{},workflow:{state:{question:'合成问题',result,original,busy,originalBusy,error},dispose(){},reset(){}}})
+  return renderToString(app)
+}
