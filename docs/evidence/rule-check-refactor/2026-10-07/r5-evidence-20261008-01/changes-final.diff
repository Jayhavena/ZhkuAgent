+            rejectBeforeRead(PROPOSAL, List.of(copy("ev-1", SOURCE, CHUNK, "v1", checksum, TEXT, true)), INVALID_CHECKSUM);
+        }
+    }
+
+    @Test void checksumHexCaseDoesNotChangeItsValue() {
