# 本文件由官方镜像的模板机制生成；端口由启动器校验，不提供外部站点回退。
server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    # 登录信息只经过代理，不把URL或会话信息写入访问日志。
    access_log off;
    error_log /dev/stderr crit;

    location ^~ /api/zhku/controlled-preview/v1/ {
        # 不附加URI：保留/api前缀，容器localhost不能代替Windows宿主机。
        proxy_pass http://host.docker.internal:${ZHKU_CONTROLLED_BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 45s;
        proxy_send_timeout 45s;
        proxy_cache off;
        # 提交确认未知由原键查询处理；代理绝不能代替用户重放POST。
        proxy_next_upstream off;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        proxy_intercept_errors off;
    }

    # 旧匿名、治理和通用Agent路径不进入本次校园展示代理。
    location = /api { return 404; }
    # proxy_pass前缀会把无尾斜杠地址自动301；精确拒绝，避免误当成可用API。
    location = /api/zhku/controlled-preview/v1 { return 404; }
    location ^~ /api/ { return 404; }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store" always;
    }

    # 真正缺失的资源返回404，不能用HTML伪装成JS/CSS。
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
    }
}
