+    location ^~ /api/zhku/controlled-preview/v2/ {
+        # 查证入口保留独立命名空间；仅当前启动的后端可处理，代理不授予身份或资料资格。
+        proxy_pass http://host.docker.internal:${ZHKU_CONTROLLED_BACKEND_PORT};
+        proxy_http_version 1.1;
+        proxy_set_header Host $http_host;
+        proxy_set_header Connection "";
