+        assertThat(service.check("合成条款",Map.of()).status()).isEqualTo(INSUFFICIENT_EVIDENCE);
+        assertThat(audited.get()).isEqualTo(1);
+    }
+    @Test void sourceWithdrawalAfterAuditIsRecheckedByDecision(){
