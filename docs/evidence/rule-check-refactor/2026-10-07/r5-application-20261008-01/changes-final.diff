+        selected.incrementAndGet(); assertThat(q).isEqualTo("合成条款");
+        assertThat(options).containsExactly(new RuleCheckApplicationService.RuleOption("test-only","合成规则查询范围"));
+        return "test-only";
+    };
+    private ChunkCandidateRetriever lexical=(q,limit)->{
