      "semanticReview": null,
      "runnerEvents": [
        {
          "attempt": 1,
          "action": "SEARCH_REVIEWED_RULES",
          "observation": {
            "actionId": "2d565772-ef62-4b9c-988b-77bf7a007b76",
            "runId": "7109d5ad-41ee-4841-ab9c-ee5c35587556",
            "step": 1,
            "status": "SUCCEEDED",
            "reasonCode": null,
            "dataLevel": "CANDIDATE",
            "catalogueVersion": "cat-4c486d2a8dfb0ae85853aedc09cb4feff50b723639cfdcedc721851c248de9f4",
            "candidates": [
              {
                "handle": "a67cc507-ab2f-4a73-b742-9e89dbdf57d0",
                "excerpt": "第十八条　公共选修课不办理缓考，成绩不合格者不安排重修。专业选\n修课成绩不合格者可申请重修学习。",
                "revision": "2025.9.2"
              },
              {
                "handle": "e4437cf5-4645-43fd-ad67-aaa40d4a1f03",
                "excerpt": "第八条　人才培养方案是学生选课的重要依据。学生应全面了解本专业\n的教学要求，在规定学习年限内按照人才培养方案的要求修读专业选修课和\n公共选修课，取得规定的学分，以达到毕业要求。选修网络公选课一般不能\n超过人才培养方案要求选修课的一半学分。",
                "revision": "2025.9.2"
              },
              {
                "handle": "3863b42c-d80c-41b9-9445-3c848f4b7a8b",
                "excerpt": "第九条　学生应根据教务处公布的公共选修课开课计划，在规定时间内\n完成网上选课。未经选课者，不得参加课程考核或考核成绩无效。",
                "revision": "2025.9.2"
              },
              {
                "handle": "52958802-ef35-42c2-a000-073205dd52a5",
                "excerpt": "第四条　学校选修课分为专业选修课和公共选修课。其中，专业选修课\n列入教学计划要求在规定学期内修读；公共选修课包\n括校内公选课和网络公选课，学生自行选课修读。",
                "revision": "2025.9.2"
              },
              {
                "handle": "4770bf5d-bff4-4b7c-9d9e-e895f2d5271c",
                "excerpt": "第十二条　选修课同必修课均在开课前一个学期排课。确定学期开课计\n划后，教务处首先安排必修课和专业选修课并保证必修课和专业选修课上课\n时间不冲突。然后，安排全校性公共选修课。",
                "revision": "2025.9.2"
              },
              {
                "handle": "4d3f84e5-c503-4ac4-a556-c61fc83872b2",
                "excerpt": "第六条　公共选修课的选课、课程组织与安排由教务处负责。其中，校\n内公选课达到一定的选课人数方可开课，选课人数一般要求 30-150 人，低于\n30 人不予开课。",
                "revision": "2025.9.2"
              },
              {
                "handle": "430e7ab1-90de-4e24-a819-8f6fe2189435",
                "excerpt": "第五条　公共选修课授课时间原则上为 16 学时，最多不超过 32 学时。",
                "revision": "2025.9.2"
              },
              {
                "handle": "fef78f8a-a3d1-4e6e-9dc0-a45f538fb71f",
                "excerpt": "第十条　每学期选修公共选修课最高不得超过 4 个学分。",
                "revision": "2025.9.2"
              },
              {
                "handle": "a18f8bbd-8d20-4766-ae01-b5a025e15845",
                "excerpt": "第二条　所有全日制普通本科学生都必须按人才培养方案要求参加选修\n课学习。",
                "revision": "2025.9.2"
              },
              {
                "handle": "ce9204e3-cb9d-4dce-b74a-ba0d8181eda3",
                "excerpt": "第十一条　学生不得选修与本专业教学计划相同或相近的课程。已考核\n合格的课程，不可重复修读。",
                "revision": "2025.9.2"
              }
            ],
