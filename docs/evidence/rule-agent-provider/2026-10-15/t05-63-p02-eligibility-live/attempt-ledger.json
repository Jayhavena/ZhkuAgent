      "wireAction": {
        "type": "SEARCH_REVIEWED_RULES",
        "subquestionId": "q1",
        "query": "选修课不及格重修规定"
      },
      "semanticReview": null,
      "runnerEvents": [
        {
          "attempt": 1,
          "action": "SEARCH_REVIEWED_RULES",
          "observation": {
            "actionId": "0dfa8d12-9c0d-468c-9e1f-29657d6018ea",
            "runId": "2cbb8c15-4ec5-4bd5-a6f9-44294605c916",
            "step": 1,
            "status": "SUCCEEDED",
            "reasonCode": null,
            "dataLevel": "CANDIDATE",
            "catalogueVersion": "cat-99eb8c90153ceff7f27b3dce138a237df087b1feb39e3e46bb18f35a8a851b26",
            "candidates": [
              {
                "handle": "b26259d6-da87-4eec-8886-872e5786844f",
                "excerpt": "第十八条　公共选修课不办理缓考，成绩不合格者不安排重修。专业选\n修课成绩不合格者可申请重修学习。",
                "revision": "2025.9.2"
              },
              {
                "handle": "06feba82-2b6f-4b48-a4c4-0a343843dd6c",
                "excerpt": "第八条　人才培养方案是学生选课的重要依据。学生应全面了解本专业\n的教学要求，在规定学习年限内按照人才培养方案的要求修读专业选修课和\n公共选修课，取得规定的学分，以达到毕业要求。选修网络公选课一般不能\n超过人才培养方案要求选修课的一半学分。",
                "revision": "2025.9.2"
              },
              {
                "handle": "0a5fae2f-e702-4499-8f8f-22d86d35c4c9",
                "excerpt": "第九条　学生应根据教务处公布的公共选修课开课计划，在规定时间内\n完成网上选课。未经选课者，不得参加课程考核或考核成绩无效。",
                "revision": "2025.9.2"
              },
              {
                "handle": "6c1ac5b6-545e-474b-8195-a88823c1879a",
                "excerpt": "第四条　学校选修课分为专业选修课和公共选修课。其中，专业选修课\n列入教学计划要求在规定学期内修读；公共选修课包\n括校内公选课和网络公选课，学生自行选课修读。",
                "revision": "2025.9.2"
              },
              {
                "handle": "1f39f95b-6032-4863-8b05-f45a1ac92769",
                "excerpt": "第十二条　选修课同必修课均在开课前一个学期排课。确定学期开课计\n划后，教务处首先安排必修课和专业选修课并保证必修课和专业选修课上课\n时间不冲突。然后，安排全校性公共选修课。",
                "revision": "2025.9.2"
              },
              {
                "handle": "6a3f35ae-fd99-4f02-98e7-c8bea89b47f0",
                "excerpt": "第六条　公共选修课的选课、课程组织与安排由教务处负责。其中，校\n内公选课达到一定的选课人数方可开课，选课人数一般要求 30-150 人，低于\n30 人不予开课。",
                "revision": "2025.9.2"
              },
              {
                "handle": "aee93aa6-c5da-4843-b62a-626ebf0a7b71",
                "excerpt": "第五条　公共选修课授课时间原则上为 16 学时，最多不超过 32 学时。",
                "revision": "2025.9.2"
              },
              {
                "handle": "7214ed72-d04b-4639-a393-51d55c1221c5",
                "excerpt": "第十条　每学期选修公共选修课最高不得超过 4 个学分。",
                "revision": "2025.9.2"
              },
              {
                "handle": "2b993beb-c3d2-4293-86c2-5b778afca4d4",
                "excerpt": "第二条　所有全日制普通本科学生都必须按人才培养方案要求参加选修\n课学习。",
                "revision": "2025.9.2"
              },
              {
                "handle": "46f5a9b7-f0d7-4864-a637-66ae3df95249",
                "excerpt": "第十一条　学生不得选修与本专业教学计划相同或相近的课程。已考核\n合格的课程，不可重复修读。",
                "revision": "2025.9.2"
              }
            ],
            "evidence": [],
            "factIds": []
          },
          "reason": null,
          "publicationReason": null
        }
