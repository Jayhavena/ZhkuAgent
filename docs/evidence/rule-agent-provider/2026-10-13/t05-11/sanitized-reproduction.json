              "runId": "ade65a56-062f-4f50-96a6-d167db45ae66",
              "step": 1,
              "status": "SUCCEEDED",
              "reasonCode": null,
              "dataLevel": "CANDIDATE",
              "catalogueVersion": "cat-6e2e8ebefefbb4b38222d240ea0ea9567353908622b6b080f9210f25085b8812",
              "candidates": [
                {
                  "handle": "a3ef4c1f-4bc9-43d0-8fd3-7aba8fae243c",
                  "excerpt": "第四条　学校选修课分为专业选修课和公共选修课。其中，专业选修课\n列入教学计划要求在规定学期内修读；公共选修课包\n括校内公选课和网络公选课，学生自行选课修读。",
                  "revision": "2025.9.2"
                },
                {
                  "handle": "159ee4e1-7bc6-4a3d-8daa-cde18c40b016",
                  "excerpt": "第八条　人才培养方案是学生选课的重要依据。学生应全面了解本专业\n的教学要求，在规定学习年限内按照人才培养方案的要求修读专业选修课和\n公共选修课，取得规定的学分，以达到毕业要求。选修网络公选课一般不能\n超过人才培养方案要求选修课的一半学分。",
                  "revision": "2025.9.2"
                },
                {
                  "handle": "412388d7-c537-40b3-b87a-41f695793dcc",
                  "excerpt": "第十二条　选修课同必修课均在开课前一个学期排课。确定学期开课计\n划后，教务处首先安排必修课和专业选修课并保证必修课和专业选修课上课\n时间不冲突。然后，安排全校性公共选修课。",
                  "revision": "2025.9.2"
                },
                {
                  "handle": "e98f7b9d-edff-4c8f-bedc-fe7baa639b41",
                  "excerpt": "第十八条　公共选修课不办理缓考，成绩不合格者不安排重修。专业选\n修课成绩不合格者可申请重修学习。",
                  "revision": "2025.9.2"
                },
                {
                  "handle": "4f190b66-0874-44bd-9559-5e0967a7d525",
                  "excerpt": "第六条　公共选修课的选课、课程组织与安排由教务处负责。其中，校\n内公选课达到一定的选课人数方可开课，选课人数一般要求 30-150 人，低于\n30 人不予开课。",
                  "revision": "2025.9.2"
                },
                {
                  "handle": "43a9c1b7-f7f9-4fa8-a7bd-197e6643fe5e",
                  "excerpt": "第十一条　学生不得选修与本专业教学计划相同或相近的课程。已考核\n合格的课程，不可重复修读。",
                  "revision": "2025.9.2"
                },
                {
                  "handle": "79507e88-539e-4363-8e70-81396581922c",
                  "excerpt": "第九条　学生应根据教务处公布的公共选修课开课计划，在规定时间内\n完成网上选课。未经选课者，不得参加课程考核或考核成绩无效。",
                  "revision": "2025.9.2"
                },
                {
                  "handle": "84110912-8496-4ada-ba78-c7324b494c03",
                  "excerpt": "第五条　公共选修课授课时间原则上为 16 学时，最多不超过 32 学时。",
                  "revision": "2025.9.2"
                },
                {
                  "handle": "d66fdf51-66cb-4d0f-b2e3-4496211e96c3",
                  "excerpt": "第十条　每学期选修公共选修课最高不得超过 4 个学分。",
                  "revision": "2025.9.2"
                },
                {
                  "handle": "263f1717-7c4b-4675-a660-93e3c1b24c72",
                  "excerpt": "第二条　所有全日制普通本科学生都必须按人才培养方案要求参加选修\n课学习。",
                  "revision": "2025.9.2"
                }
              ],
              "evidence": [],
              "factIds": []
            },
