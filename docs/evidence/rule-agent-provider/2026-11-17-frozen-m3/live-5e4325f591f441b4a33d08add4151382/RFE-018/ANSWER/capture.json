  "searches" : [ {
    "observationId" : "a4e66a39-c1f3-4457-afb0-385595d52ac6",
    "runId" : "b4c6bbdb-f6d3-4cdc-8c44-2a067a26f446",
    "step" : 1,
    "status" : "SUCCEEDED",
    "candidates" : [ {
      "handle" : "48d40009-7cd3-4436-934f-afd9804a8da4",
      "excerpt" : "第八条　人才培养方案是学生选课的重要依据。学生应全面了解本专业\n的教学要求，在规定学习年限内按照人才培养方案的要求修读专业选修课和\n公共选修课，取得规定的学分，以达到毕业要求。选修网络公选课一般不能\n超过人才培养方案要求选修课的一半学分。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "ac12d48e-c102-4fa9-a4a4-3ccd18b18f4d",
      "excerpt" : "第十二条　选修课同必修课均在开课前一个学期排课。确定学期开课计\n划后，教务处首先安排必修课和专业选修课并保证必修课和专业选修课上课\n时间不冲突。然后，安排全校性公共选修课。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "effdcead-293a-41ce-8def-d2357c9aa840",
      "excerpt" : "第六条　公共选修课的选课、课程组织与安排由教务处负责。其中，校\n内公选课达到一定的选课人数方可开课，选课人数一般要求 30-150 人，低于\n30 人不予开课。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "3197f9df-4d2c-4781-9ca7-c5798d76d8d9",
      "excerpt" : "第九条　学生应根据教务处公布的公共选修课开课计划，在规定时间内\n完成网上选课。未经选课者，不得参加课程考核或考核成绩无效。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "8920520c-6751-4815-96d1-5f1deff2faf1",
      "excerpt" : "第五条　公共选修课授课时间原则上为 16 学时，最多不超过 32 学时。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "11fd6bff-5e09-459b-8bfe-9404a28ab326",
      "excerpt" : "第四条　学校选修课分为专业选修课和公共选修课。其中，专业选修课\n列入教学计划要求在规定学期内修读；公共选修课包\n括校内公选课和网络公选课，学生自行选课修读。",
      "revision" : "2025.9.2"
    } ]
  }, {
    "observationId" : "4dd11d00-d985-4d69-be7f-6a73ae5ae3d1",
    "runId" : "b4c6bbdb-f6d3-4cdc-8c44-2a067a26f446",
    "step" : 2,
    "status" : "SUCCEEDED",
    "candidates" : [ {
