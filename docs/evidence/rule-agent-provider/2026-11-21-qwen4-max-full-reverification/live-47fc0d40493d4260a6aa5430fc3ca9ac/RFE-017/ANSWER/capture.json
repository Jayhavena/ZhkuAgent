  "searches" : [ {
    "observationId" : "cbdf65a4-e112-4166-b393-acfbfff2c554",
    "runId" : "cccce2d5-ef4f-4516-aa93-880a644e37b2",
    "step" : 1,
    "status" : "SUCCEEDED",
    "candidates" : [ {
      "handle" : "29741248-bd46-4acf-ac12-822524ec1791",
      "excerpt" : "第十二条　选修课同必修课均在开课前一个学期排课。确定学期开课计\n划后，教务处首先安排必修课和专业选修课并保证必修课和专业选修课上课\n时间不冲突。然后，安排全校性公共选修课。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "b8ad19a5-5421-476a-84e3-c318a8e40c61",
      "excerpt" : "第四条　学校选修课分为专业选修课和公共选修课。其中，专业选修课\n列入教学计划要求在规定学期内修读；公共选修课包\n括校内公选课和网络公选课，学生自行选课修读。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "97be3cc4-1b64-4be4-9daa-2f54658294f3",
      "excerpt" : "第八条　人才培养方案是学生选课的重要依据。学生应全面了解本专业\n的教学要求，在规定学习年限内按照人才培养方案的要求修读专业选修课和\n公共选修课，取得规定的学分，以达到毕业要求。选修网络公选课一般不能\n超过人才培养方案要求选修课的一半学分。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "85828e98-00d8-4428-9033-415780d2b4aa",
      "excerpt" : "第六条　公共选修课的选课、课程组织与安排由教务处负责。其中，校\n内公选课达到一定的选课人数方可开课，选课人数一般要求 30-150 人，低于\n30 人不予开课。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "69237386-225a-4309-99be-acd6f2575be9",
      "excerpt" : "第十八条　公共选修课不办理缓考，成绩不合格者不安排重修。专业选\n修课成绩不合格者可申请重修学习。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "c764d65b-38e3-4b43-9f05-1ff57d0467e9",
      "excerpt" : "第九条　学生应根据教务处公布的公共选修课开课计划，在规定时间内\n完成网上选课。未经选课者，不得参加课程考核或考核成绩无效。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "fcfc08f8-2026-4246-b53c-f541b17d1b7b",
      "excerpt" : "第十一条　学生不得选修与本专业教学计划相同或相近的课程。已考核\n合格的课程，不可重复修读。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "85429ffd-f5af-43d2-9de3-d55d497b27b8",
      "excerpt" : "第十条　每学期选修公共选修课最高不得超过 4 个学分。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "f30fa50e-2192-4c35-9c76-adc351c4d647",
      "excerpt" : "第五条　公共选修课授课时间原则上为 16 学时，最多不超过 32 学时。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "97e9edf1-0fe0-41db-988a-47e097b00127",
      "excerpt" : "第二条　所有全日制普通本科学生都必须按人才培养方案要求参加选修\n课学习。",
      "revision" : "2025.9.2"
    } ]
  } ],
