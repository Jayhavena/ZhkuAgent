  "searches" : [ {
    "observationId" : "bed48081-e122-4978-8293-ab8ff58241cb",
    "runId" : "ce21816d-8af7-46f0-9e85-9ecf3d1f9328",
    "step" : 1,
    "status" : "SUCCEEDED",
    "candidates" : [ {
      "handle" : "6999ffce-1f99-4c8e-ad0d-4c4cfbd1bc82",
      "excerpt" : "第九条　学生应根据教务处公布的公共选修课开课计划，在规定时间内\n完成网上选课。未经选课者，不得参加课程考核或考核成绩无效。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "9e6aed6a-3028-4066-9dee-2e57751921f0",
      "excerpt" : "第十一条　学生不得选修与本专业教学计划相同或相近的课程。已考核\n合格的课程，不可重复修读。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "67087c68-fc60-4176-8176-ad53495a037f",
      "excerpt" : "第六条　公共选修课的选课、课程组织与安排由教务处负责。其中，校\n内公选课达到一定的选课人数方可开课，选课人数一般要求 30-150 人，低于\n30 人不予开课。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "25393364-0ac2-4b7e-940d-043f6afbcda8",
      "excerpt" : "第二条　所有全日制普通本科学生都必须按人才培养方案要求参加选修\n课学习。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "d5edf444-56f4-4657-bc49-247141f44c35",
      "excerpt" : "第十八条　公共选修课不办理缓考，成绩不合格者不安排重修。专业选\n修课成绩不合格者可申请重修学习。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "9331c6c0-2038-4a8d-8d1d-2b2935e24cb9",
      "excerpt" : "第八条　人才培养方案是学生选课的重要依据。学生应全面了解本专业\n的教学要求，在规定学习年限内按照人才培养方案的要求修读专业选修课和\n公共选修课，取得规定的学分，以达到毕业要求。选修网络公选课一般不能\n超过人才培养方案要求选修课的一半学分。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "f14cf1ba-e83d-470f-9196-cebf2c74793c",
      "excerpt" : "第四条　学校选修课分为专业选修课和公共选修课。其中，专业选修课\n列入教学计划要求在规定学期内修读；公共选修课包\n括校内公选课和网络公选课，学生自行选课修读。",
      "revision" : "2025.9.2"
    } ]
  } ],
