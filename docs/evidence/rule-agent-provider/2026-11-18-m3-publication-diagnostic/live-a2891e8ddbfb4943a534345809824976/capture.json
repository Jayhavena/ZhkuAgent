  "searches" : [ {
    "observationId" : "63e2ab49-725c-4952-a652-35cf2a8e768c",
    "runId" : "2cd20b78-25b0-4972-b556-d17c743d2740",
    "step" : 1,
    "status" : "SUCCEEDED",
    "candidates" : [ {
      "handle" : "134c546f-696c-4c8b-af88-16a2cd2eb2da",
      "excerpt" : "第四条　学校选修课分为专业选修课和公共选修课。其中，专业选修课\n列入教学计划要求在规定学期内修读；公共选修课包\n括校内公选课和网络公选课，学生自行选课修读。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "df3aaa5a-e1d7-44da-8d50-efaa2dc409a5",
      "excerpt" : "第八条　人才培养方案是学生选课的重要依据。学生应全面了解本专业\n的教学要求，在规定学习年限内按照人才培养方案的要求修读专业选修课和\n公共选修课，取得规定的学分，以达到毕业要求。选修网络公选课一般不能\n超过人才培养方案要求选修课的一半学分。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "5cda60bd-eb37-4d7f-993d-cd8eb4616a6b",
      "excerpt" : "第十二条　选修课同必修课均在开课前一个学期排课。确定学期开课计\n划后，教务处首先安排必修课和专业选修课并保证必修课和专业选修课上课\n时间不冲突。然后，安排全校性公共选修课。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "3d30ca32-5540-479c-9140-0011eb1992b7",
      "excerpt" : "第六条　公共选修课的选课、课程组织与安排由教务处负责。其中，校\n内公选课达到一定的选课人数方可开课，选课人数一般要求 30-150 人，低于\n30 人不予开课。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "7daea478-d97e-4993-b079-8f772f03ba1e",
      "excerpt" : "第九条　学生应根据教务处公布的公共选修课开课计划，在规定时间内\n完成网上选课。未经选课者，不得参加课程考核或考核成绩无效。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "4c8c7112-79c1-4879-b781-b31fc5047ba4",
      "excerpt" : "第十八条　公共选修课不办理缓考，成绩不合格者不安排重修。专业选\n修课成绩不合格者可申请重修学习。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "b4efcbe5-ec3f-42cd-93fa-94db30095a92",
      "excerpt" : "第五条　公共选修课授课时间原则上为 16 学时，最多不超过 32 学时。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "3fc8a5c6-d2d9-470f-a5b8-655bf4796a2a",
      "excerpt" : "第十条　每学期选修公共选修课最高不得超过 4 个学分。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "37268e2a-882b-4e0a-96cc-45acc609a5b2",
      "excerpt" : "第二条　所有全日制普通本科学生都必须按人才培养方案要求参加选修\n课学习。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "af3087c6-7167-4ebc-8494-6beafc536dda",
      "excerpt" : "第十一条　学生不得选修与本专业教学计划相同或相近的课程。已考核\n合格的课程，不可重复修读。",
      "revision" : "2025.9.2"
    } ]
  } ],
