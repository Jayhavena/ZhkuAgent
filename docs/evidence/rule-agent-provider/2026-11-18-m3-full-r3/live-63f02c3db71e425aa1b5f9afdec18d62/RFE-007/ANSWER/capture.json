    "evidence" : [ {
      "id" : "36fe0145-61fe-40fc-a71e-e872944f3dae:0-119",
      "sourceId" : "4dca8c76-9f1c-4f99-9f82-fce105f7bde6",
      "chunkId" : "f0a840b2-48c3-374c-b0b3-d7af48d15d64",
      "revision" : "2025.9.2",
      "checksum" : "056217b8775854fbadb44fff38af48c1ed37e1c3b0c92563e1681186387ffeb2",
      "startInclusive" : 0,
      "endExclusive" : 119,
      "quote" : "第八条　人才培养方案是学生选课的重要依据。学生应全面了解本专业\n的教学要求，在规定学习年限内按照人才培养方案的要求修读专业选修课和\n公共选修课，取得规定的学分，以达到毕业要求。选修网络公选课一般不能\n超过人才培养方案要求选修课的一半学分。"
    } ],
