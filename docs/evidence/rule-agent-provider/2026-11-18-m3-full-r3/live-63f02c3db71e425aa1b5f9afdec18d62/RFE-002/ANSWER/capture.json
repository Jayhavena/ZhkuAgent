  "searches" : [ {
    "observationId" : "dc6c92ab-235a-4414-ac1d-aef09329b6a4",
    "runId" : "09b93f09-9b9b-4e65-912d-52c495b896bb",
    "step" : 1,
    "status" : "SUCCEEDED",
    "candidates" : [ {
      "handle" : "45eb7d48-4106-4ee9-9956-cfa03e476c13",
      "excerpt" : "第八条　人才培养方案是学生选课的重要依据。学生应全面了解本专业\n的教学要求，在规定学习年限内按照人才培养方案的要求修读专业选修课和\n公共选修课，取得规定的学分，以达到毕业要求。选修网络公选课一般不能\n超过人才培养方案要求选修课的一半学分。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "6ecc33fe-7f69-42dd-bb85-172e90861a6c",
      "excerpt" : "第四条　学校选修课分为专业选修课和公共选修课。其中，专业选修课\n列入教学计划要求在规定学期内修读；公共选修课包\n括校内公选课和网络公选课，学生自行选课修读。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "a0c8881f-8553-4be9-8734-7d8c4241dd08",
      "excerpt" : "第二条　所有全日制普通本科学生都必须按人才培养方案要求参加选修\n课学习。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "35e91d23-3332-4f33-b96b-99878a4dcc9d",
      "excerpt" : "第六条　公共选修课的选课、课程组织与安排由教务处负责。其中，校\n内公选课达到一定的选课人数方可开课，选课人数一般要求 30-150 人，低于\n30 人不予开课。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "5cdeb98a-2a18-4e8b-9467-57b82b5ae129",
      "excerpt" : "第九条　学生应根据教务处公布的公共选修课开课计划，在规定时间内\n完成网上选课。未经选课者，不得参加课程考核或考核成绩无效。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "306e9528-5f93-4b1f-9507-8f69e7e52fec",
      "excerpt" : "第十一条　学生不得选修与本专业教学计划相同或相近的课程。已考核\n合格的课程，不可重复修读。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "eecb8f75-cad7-4d3e-a522-6a4c2edb5a25",
      "excerpt" : "第十二条　选修课同必修课均在开课前一个学期排课。确定学期开课计\n划后，教务处首先安排必修课和专业选修课并保证必修课和专业选修课上课\n时间不冲突。然后，安排全校性公共选修课。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "8d2b3aa9-2576-44f5-8991-6db09960ba71",
      "excerpt" : "第十八条　公共选修课不办理缓考，成绩不合格者不安排重修。专业选\n修课成绩不合格者可申请重修学习。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "8a6dce78-5918-4a48-ba82-27a947bceb67",
      "excerpt" : "第五条　公共选修课授课时间原则上为 16 学时，最多不超过 32 学时。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "2e30c799-8088-4d2f-ba61-117d2070b851",
      "excerpt" : "第十条　每学期选修公共选修课最高不得超过 4 个学分。",
      "revision" : "2025.9.2"
    } ]
  } ],
