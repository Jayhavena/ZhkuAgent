  "searches" : [ {
    "observationId" : "8199deda-382c-47b0-82ac-aa45b6c8f6fd",
    "runId" : "2d740aa5-b363-46f4-9ef4-084717f04dcf",
    "step" : 1,
    "status" : "SUCCEEDED",
    "candidates" : [ {
      "handle" : "ab447aaa-9854-470f-8d4d-dcbd17166512",
      "excerpt" : "第八条　人才培养方案是学生选课的重要依据。学生应全面了解本专业\n的教学要求，在规定学习年限内按照人才培养方案的要求修读专业选修课和\n公共选修课，取得规定的学分，以达到毕业要求。选修网络公选课一般不能\n超过人才培养方案要求选修课的一半学分。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "71dbe509-358c-46e7-b23e-3700bfb635f6",
      "excerpt" : "第十二条　选修课同必修课均在开课前一个学期排课。确定学期开课计\n划后，教务处首先安排必修课和专业选修课并保证必修课和专业选修课上课\n时间不冲突。然后，安排全校性公共选修课。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "ec5e59ef-ee47-4e6e-b421-0b909bbea09e",
      "excerpt" : "第六条　公共选修课的选课、课程组织与安排由教务处负责。其中，校\n内公选课达到一定的选课人数方可开课，选课人数一般要求 30-150 人，低于\n30 人不予开课。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "cb5f17a2-a245-41a9-a78d-3ad0fcc6456a",
      "excerpt" : "第九条　学生应根据教务处公布的公共选修课开课计划，在规定时间内\n完成网上选课。未经选课者，不得参加课程考核或考核成绩无效。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "e2ae44ba-da32-4368-8962-0d9fab36780a",
      "excerpt" : "第五条　公共选修课授课时间原则上为 16 学时，最多不超过 32 学时。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "a4d76970-019b-43bb-a295-6314cfc0950f",
      "excerpt" : "第四条　学校选修课分为专业选修课和公共选修课。其中，专业选修课\n列入教学计划要求在规定学期内修读；公共选修课包\n括校内公选课和网络公选课，学生自行选课修读。",
      "revision" : "2025.9.2"
    } ]
  }, {
    "observationId" : "d71d1325-2dc0-49e8-b8fd-d40393e47081",
    "runId" : "2d740aa5-b363-46f4-9ef4-084717f04dcf",
    "step" : 2,
    "status" : "SUCCEEDED",
    "candidates" : [ {
      "handle" : "9f9fca7a-a5e4-4216-9a68-95dacab399f6",
      "excerpt" : "第九条　学生应根据教务处公布的公共选修课开课计划，在规定时间内\n完成网上选课。未经选课者，不得参加课程考核或考核成绩无效。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "c2aa3ec7-f80a-45b2-afb3-4ca6a9281a4f",
      "excerpt" : "第十八条　公共选修课不办理缓考，成绩不合格者不安排重修。专业选\n修课成绩不合格者可申请重修学习。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "a0f8e613-f550-4057-956e-70f3714dab2a",
      "excerpt" : "第八条　人才培养方案是学生选课的重要依据。学生应全面了解本专业\n的教学要求，在规定学习年限内按照人才培养方案的要求修读专业选修课和\n公共选修课，取得规定的学分，以达到毕业要求。选修网络公选课一般不能\n超过人才培养方案要求选修课的一半学分。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "62630899-40b1-4541-9940-f82a65ebca28",
      "excerpt" : "第十二条　选修课同必修课均在开课前一个学期排课。确定学期开课计\n划后，教务处首先安排必修课和专业选修课并保证必修课和专业选修课上课\n时间不冲突。然后，安排全校性公共选修课。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "9757e58c-e8c4-4d11-8a5d-a4614545a68f",
      "excerpt" : "第五条　公共选修课授课时间原则上为 16 学时，最多不超过 32 学时。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "691c4c28-35e9-4e99-a2b9-eea522f32888",
      "excerpt" : "第四条　学校选修课分为专业选修课和公共选修课。其中，专业选修课\n列入教学计划要求在规定学期内修读；公共选修课包\n括校内公选课和网络公选课，学生自行选课修读。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "2112da6c-794d-4d63-a509-9fcf05df2c23",
      "excerpt" : "第六条　公共选修课的选课、课程组织与安排由教务处负责。其中，校\n内公选课达到一定的选课人数方可开课，选课人数一般要求 30-150 人，低于\n30 人不予开课。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "cc2a30bc-b83d-47b8-9680-a6617bc8acd8",
      "excerpt" : "第十条　每学期选修公共选修课最高不得超过 4 个学分。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "1b61f61f-59c6-4b00-8e9d-c3046f06ae5b",
      "excerpt" : "第二条　所有全日制普通本科学生都必须按人才培养方案要求参加选修\n课学习。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "bef6bab4-f345-41da-845f-9ee2dc1ba4a6",
      "excerpt" : "第十一条　学生不得选修与本专业教学计划相同或相近的课程。已考核\n合格的课程，不可重复修读。",
      "revision" : "2025.9.2"
    } ]
  } ],
