    "catalogueVersion" : "cat-b66edd2357479ffc6ab33a21f2d09ce29002ba43ee32458dc8b69254f4ef7e88",
    "candidates" : [ {
      "handle" : "800716b0-9553-4ec5-a287-10c83f8c625e",
      "excerpt" : "第四条　学校选修课分为专业选修课和公共选修课。其中，专业选修课\n列入教学计划要求在规定学期内修读；公共选修课包\n括校内公选课和网络公选课，学生自行选课修读。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "7fcbdbd5-28f2-4873-9d3c-91bb341668f1",
      "excerpt" : "第八条　人才培养方案是学生选课的重要依据。学生应全面了解本专业\n的教学要求，在规定学习年限内按照人才培养方案的要求修读专业选修课和\n公共选修课，取得规定的学分，以达到毕业要求。选修网络公选课一般不能\n超过人才培养方案要求选修课的一半学分。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "04b27277-1e78-43ff-b40c-5f53dbc8e3a8",
      "excerpt" : "第十二条　选修课同必修课均在开课前一个学期排课。确定学期开课计\n划后，教务处首先安排必修课和专业选修课并保证必修课和专业选修课上课\n时间不冲突。然后，安排全校性公共选修课。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "e83da294-f8db-49f2-bec9-a2e62bf32afb",
      "excerpt" : "第十八条　公共选修课不办理缓考，成绩不合格者不安排重修。专业选\n修课成绩不合格者可申请重修学习。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "7f593162-3f73-4f14-9b76-6ddbbb03f84d",
      "excerpt" : "第六条　公共选修课的选课、课程组织与安排由教务处负责。其中，校\n内公选课达到一定的选课人数方可开课，选课人数一般要求 30-150 人，低于\n30 人不予开课。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "9aef757f-b7d7-4dd3-b2b4-ae550a53fce2",
      "excerpt" : "第十九条　因学籍异动、转学、校际交流、创新创业、社会实践等取得\n的专业教学计划外的课程学分，经本人申请，教务处审核同意，可以折算为\n公共选修课学分。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "7b5315f5-6e7d-4846-9ea1-8df372ed2547",
      "excerpt" : "第九条　学生应根据教务处公布的公共选修课开课计划，在规定时间内\n完成网上选课。未经选课者，不得参加课程考核或考核成绩无效。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "036c41c7-4f52-40e7-a521-aef61f9fd0e9",
      "excerpt" : "第五条　公共选修课授课时间原则上为 16 学时，最多不超过 32 学时。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "2b7f3cfb-0d34-4cb2-b22e-20deff3e3570",
      "excerpt" : "第十条　每学期选修公共选修课最高不得超过 4 个学分。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "e96e9a8a-aed9-460a-a024-0de40d958354",
      "excerpt" : "第十一条　学生不得选修与本专业教学计划相同或相近的课程。已考核\n合格的课程，不可重复修读。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "bb7c89b8-dc41-4b8a-84dd-bd3b5ffc4991",
      "excerpt" : "第七条　各院（部）应高度重视选修课的课程建设，教务处负责定期检\n查并反馈建设及教学情况。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "bc2f8780-e753-43c8-8014-68f068b9a215",
      "excerpt" : "第三条　选修课教学管理要求与必修课相同，必须按照规范的教学管理\n机制和教学质量标准执行。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "1e72cec6-ef3d-4186-a43a-b0c74664f6ec",
      "excerpt" : "第一条　选修课教学属于教学计划内教学任务，各院（部）及教师均有\n承担选修课教学任务的责任。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "c789cb97-2111-4eb2-a471-b204e3346ca6",
      "excerpt" : "第十五条　学生应严格遵守考勤制度。因特殊原因无法上课的，应提前\n履行请假手续。学生缺课累计超过该门课程学期总学时数的 30% 时，其平时\n成绩评定为不及格，不允许参加课终考核，课程成绩按 0 分登记。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "a7c0d312-433b-4039-846a-2852b7c79012",
      "excerpt" : "第二条　所有全日制普通本科学生都必须按人才培养方案要求参加选修\n课学习。",
      "revision" : "2025.9.2"
    }, {
      "handle" : "5882be7b-35cf-49ce-b39f-ee379a32ef37",
      "excerpt" : "第二十条　本办法自公布之日起执行，由教务处负责解释，原《仲恺农业\n工程学院课程选修暂行管理办法》 （仲教字﹝ 2011 ﹞ 11 号附件 11）同时废止。",
      "revision" : "2025.9.2"
    } ],
    "evidence" : [ ],
