      "reasonCode" : null,
      "dataLevel" : "CANDIDATE",
      "catalogueVersion" : "cat-3635ed3043b29776d11cc8d6287935207f29a1a239c2c3301a333edf3bda3cf7",
      "candidates" : [ {
        "handle" : "8cf8b7d4-573b-4cae-9c55-e83b25ee9f9b",
        "excerpt" : "第十八条　公共选修课不办理缓考，成绩不合格者不安排重修。专业选\n修课成绩不合格者可申请重修学习。",
        "revision" : "2025.9.2"
      }, {
        "handle" : "281eb64a-a061-4f25-9329-b0f33a0a9dc5",
        "excerpt" : "第八条　人才培养方案是学生选课的重要依据。学生应全面了解本专业\n的教学要求，在规定学习年限内按照人才培养方案的要求修读专业选修课和\n公共选修课，取得规定的学分，以达到毕业要求。选修网络公选课一般不能\n超过人才培养方案要求选修课的一半学分。",
        "revision" : "2025.9.2"
      }, {
        "handle" : "47af3c2e-35ca-4540-b354-abf8e43e7ff0",
        "excerpt" : "第十二条　选修课同必修课均在开课前一个学期排课。确定学期开课计\n划后，教务处首先安排必修课和专业选修课并保证必修课和专业选修课上课\n时间不冲突。然后，安排全校性公共选修课。",
        "revision" : "2025.9.2"
      }, {
        "handle" : "5f9654f6-2b44-4e6b-b43f-530bbddda688",
        "excerpt" : "第六条　公共选修课的选课、课程组织与安排由教务处负责。其中，校\n内公选课达到一定的选课人数方可开课，选课人数一般要求 30-150 人，低于\n30 人不予开课。",
        "revision" : "2025.9.2"
      }, {
        "handle" : "825a7b67-d3f9-4c2a-bd7b-ee3ffa4e3ad6",
        "excerpt" : "第九条　学生应根据教务处公布的公共选修课开课计划，在规定时间内\n完成网上选课。未经选课者，不得参加课程考核或考核成绩无效。",
        "revision" : "2025.9.2"
      }, {
        "handle" : "f3563951-a8f4-452d-bf61-d5b5f8b9e81d",
        "excerpt" : "第五条　公共选修课授课时间原则上为 16 学时，最多不超过 32 学时。",
        "revision" : "2025.9.2"
      }, {
        "handle" : "4158a49f-a27a-4088-8192-4169b0db9371",
        "excerpt" : "第十条　每学期选修公共选修课最高不得超过 4 个学分。",
        "revision" : "2025.9.2"
      }, {
        "handle" : "611cce1d-b4e5-4af6-89d2-c3461a07e7fc",
        "excerpt" : "第四条　学校选修课分为专业选修课和公共选修课。其中，专业选修课\n列入教学计划要求在规定学期内修读；公共选修课包\n括校内公选课和网络公选课，学生自行选课修读。",
        "revision" : "2025.9.2"
      }, {
        "handle" : "cacf4102-7bf6-40a0-acfb-90fc02781c94",
        "excerpt" : "第二条　所有全日制普通本科学生都必须按人才培养方案要求参加选修\n课学习。",
        "revision" : "2025.9.2"
      }, {
        "handle" : "6eed9a96-9e35-4873-9457-646c823d56cf",
        "excerpt" : "第十一条　学生不得选修与本专业教学计划相同或相近的课程。已考核\n合格的课程，不可重复修读。",
        "revision" : "2025.9.2"
      } ],
