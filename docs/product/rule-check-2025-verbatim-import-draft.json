      "visibilityScope": "INTERNAL_ONLY",
      "sharingRightsConfirmed": false,
      "content": "第二条　所有全日制普通本科学生都必须按人才培养方案要求参加选修\n课学习。",
      "contentChecksum": "2d1dbdbee0a567fea8c345a62e6568bc93d373d36518c5b62253a11f5f136dd1",
      "span": {
        "unit": "UTF16_CODE_UNIT",
