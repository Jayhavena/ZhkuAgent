<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.zhku</groupId><artifactId>zhku-agent</artifactId><version>0.1.0-rc.1</version><relativePath>../pom.xml</relativePath></parent>
  <groupId>com.zhku</groupId><artifactId>knowledge</artifactId><version>0.1.0-rc.1</version>
  <name>ZhkuAgent Knowledge</name>
  <properties>
    <zhku.data-root>${project.basedir}</zhku.data-root>
    <!-- Spring AI 版本锁定：1.0.x 对应 Spring Boot 3.4.x；升级需同步评估 Boot 版本与合同测试。 -->
    <spring-ai.version>1.0.9</spring-ai.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <!-- 只共享运行上下文，不引入 agent 的通用工具与 Alibaba starter。 -->
    <dependency><groupId>com.zhku</groupId><artifactId>agent-runtime</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <!-- 仅新受控入口启用安全链；旧入口显式排除安全自动配置，版本沿用Boot BOM。 -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.apache.pdfbox</groupId><artifactId>pdfbox</artifactId><version>2.0.35</version></dependency>
    <!--
      只引入 Spring AI 的库模块（而非 starter）：starter 会带来自动配置，
      要求启动时即存在 api-key，会污染本机预览与治理台的启动条件。
      依赖装配由 RagProviderConfiguration 显式完成，一次只启用一个 profile。
    -->
    <dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-openai</artifactId></dependency>
    <dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-pgvector-store</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><configuration><workingDirectory>${zhku.data-root}</workingDirectory></configuration></plugin>
    <!-- 原入口保留；受控入口独立打包，不让认证配置污染旧单人模式。普通jar供CLI使用。 -->
    <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><executions>
      <execution><id>repackage</id><configuration><skip>true</skip></configuration></execution>
      <execution><id>preview</id><goals><goal>repackage</goal></goals><configuration><classifier>preview</classifier><mainClass>com.zhku.knowledge.web.ZhkuLocalPreviewApplication</mainClass></configuration></execution>
      <execution><id>admin</id><goals><goal>repackage</goal></goals><configuration><classifier>admin</classifier><mainClass>com.zhku.knowledge.governance.web.ZhkuLocalAdminApplication</mainClass></configuration></execution>
      <execution><id>index</id><goals><goal>repackage</goal></goals><configuration><classifier>index</classifier><mainClass>com.zhku.knowledge.retrieval.IndexPublishedKnowledgeCli</mainClass></configuration></execution>
      <execution><id>controlled</id><goals><goal>repackage</goal></goals><configuration><classifier>controlled</classifier><mainClass>com.zhku.knowledge.controlled.ControlledPreviewApplication</mainClass></configuration></execution>
    </executions></plugin>
  </plugins></build>
</project>
